# Copy to .env and fill in. Never commit .env.
# The values below match the local Docker databases started by docker/dev-db.sh.

# --- Databases (the app only ever reads through these) -----------------------
SQLITE_PATH=data/bookstore.db

# Use READ-ONLY database users here. Production examples:
#   POSTGRES_URL=postgresql://talktable_ro:<password>@<host>.neon.tech/bookstore?sslmode=require
#   MONGO_URL=mongodb+srv://talktable_ro:<password>@<cluster>.mongodb.net
POSTGRES_URL=postgresql://talktable_ro:talktable_ro_dev@localhost:5433/bookstore
MONGO_URL=mongodb://talktable_ro:talktable_ro_dev@localhost:27017/?authSource=bookstore
MONGO_DB=bookstore

# Write-capable URLs, used ONLY by the seed scripts in data/seed/.
# Leave them unset on Hugging Face Spaces.
POSTGRES_SEED_URL=postgresql://talktable:talktable_dev@localhost:5433/bookstore
MONGO_SEED_URL=mongodb://root:root_dev@localhost:27017/?authSource=admin

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=ollama          # ollama | hf | groq
# LLM_MODEL picks the database and writes the answers. LLM_QUERY_MODEL (optional)
# writes the SQL / Mongo queries; leave it empty to use LLM_MODEL for everything
# (do that with hf / groq). Measured on a 4 GB laptop GPU, 6 test questions:
#   qwen3:14b + LLM_QUERY_MODEL=qwen2.5-coder:7b   6/6, ~62 s/question
#   qwen3:14b alone                                6/6, ~52 s/question
#   qwen2.5-coder:7b alone                         6/6 queries, ~17 s/question, but its
#                                                  answers sometimes invent details
#   mistral:7b alone                               4/6, ~25 s/question
# Hosted examples: Qwen/Qwen2.5-72B-Instruct (hf), llama-3.3-70b-versatile (groq).
LLM_MODEL=qwen3:14b
LLM_QUERY_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
HF_TOKEN=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=180

# On a Hugging Face Space there is no .env: set POSTGRES_URL, MONGO_URL and the API key
# as Space *secrets*, LLM_PROVIDER / LLM_MODEL / MONGO_DB as variables, and leave
# LLM_QUERY_MODEL unset. Step by step: docs/deploy.md
#   LLM_PROVIDER=groq   LLM_MODEL=llama-3.3-70b-versatile   GROQ_API_KEY=gsk_...
#   LLM_PROVIDER=hf     LLM_MODEL=Qwen/Qwen2.5-72B-Instruct HF_TOKEN=hf_...

# --- Schema vectors --------------------------------------------------------------
# auto: NumPy in memory for small schemas; Qdrant when QDRANT_URL is set or the schemas
# have VECTOR_STORE_AUTO_TABLES tables or more (then vectors persist and restarts only
# embed what changed). Or force one with numpy / qdrant.
VECTOR_STORE=auto
# QDRANT_URL=http://localhost:6333     # a Qdrant server; unset = embedded in QDRANT_PATH
# QDRANT_API_KEY=
# QDRANT_PATH=data/qdrant              # embedded mode: one process at a time per folder

# --- Answer cache --------------------------------------------------------------
# Repeated questions reuse their saved query (re-run on the current data) and skip the LLM.
CACHE_ENABLED=true
CACHE_PATH=data/answer_cache.sqlite
CACHE_TTL_HOURS=168

# --- Limits ------------------------------------------------------------------
MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
